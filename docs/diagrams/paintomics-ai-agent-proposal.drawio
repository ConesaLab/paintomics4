        </mxCell>
        <mxCell id="tc" value="&lt;b&gt;Self-check&lt;/b&gt;  (verification.py)&#xa;check_my_citations()&#xa;advisory early feedback —&#xa;never a substitute for the exit gate" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="TOOLS">
          <mxGeometry x="320" y="50" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ts" value="&lt;b&gt;submit_report(draft)&lt;/b&gt;&#xa;the only door out of the loop —&#xa;and it opens into the exit gate,&#xa;never straight to the user" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="TOOLS">
