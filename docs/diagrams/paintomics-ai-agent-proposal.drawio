  <diagram id="agent_proposal" name="Proposed full agent">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Proposed: PaintOmics AI as a full agent  —  agent side only" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="tb" value="Control inverted: one Lead Agent runs a loop; today's six phases become its toolbelt; the guards move outside the loop where the model cannot decline them" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="64" width="1360" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="LOOP" value="Lead Interpreter Agent — the loop (replaces agent.py::_run_async's fixed sequence)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;pointerEvents=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="640" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="obs" value="&lt;b&gt;Observe&lt;/b&gt;&#xa;notebook so far · budget ledger ·&#xa;data summaries · last tool result" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="LOOP">
          <mxGeometry x="30" y="50" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="dec" value="&lt;b&gt;Decide&lt;/b&gt;&#xa;one streamed LLM call:&#xa;pick the next action —&#xa;or declare coverage complete" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="LOOP">
          <mxGeometry x="350" y="50" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="act" value="&lt;b&gt;Act&lt;/b&gt;&#xa;execute the chosen tool" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="LOOP">
          <mxGeometry x="350" y="180" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="chk" value="coverage checklist satisfied?&#xa;(every major pathway has evidence,&#xa;open questions resolved or noted)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="LOOP">
          <mxGeometry x="40" y="180" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="yesnote" value="yes → Decide calls submit_report(draft)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#8a7a2a;" vertex="1" parent="LOOP">
          <mxGeometry x="40" y="268" width="250" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="caps" value="&lt;b&gt;Loop backstops — not the agent's choice&lt;/b&gt;&#xa;max turns · token budget · AI_MAX_RUN_SECONDS wall-clock · cancel flag&#xa;(the cage the loop runs inside; hitting one ends the run, never silently)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="LOOP">
          <mxGeometry x="30" y="300" width="580" height="90" as="geometry"/>
