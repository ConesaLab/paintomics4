          <mxGeometry x="420" y="45" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="llm" value="LLM gateway (streamed)&#xa;every Decide / sub-agent call&#xa;— a stronger backend than the CSIC&#xa;gateway is a precondition, not a nicety" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="400" width="340" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="TOOLS" value="Toolbelt — existing modules wrapped as tools  ·  the agent chooses WHAT, the tool enforces HOW MUCH" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;pointerEvents=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
