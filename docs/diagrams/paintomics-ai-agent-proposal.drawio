        </mxCell>
        <mxCell id="tl" value="&lt;b&gt;Literature tools&lt;/b&gt;  (pubmed_client)&#xa;search_literature(query) — spend meter,&#xa;rate limit, returns 'budget left: N'&#xa;read_paper(ref, section)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="TOOLS">
