        </mxCell>
        <mxCell id="td" value="&lt;b&gt;Data tools&lt;/b&gt;  (context_builder, clusters)&#xa;get_experiment_overview()&#xa;get_pathway_details(ids)&#xa;get_gene_profile(symbol)&#xa;cluster_pathways()" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="TOOLS">
