        </mxCell>
        <mxCell id="tg" value="&lt;b&gt;delegate(subtask)&lt;/b&gt;&#xa;fan-out lives INSIDE the tool as&#xa;parallel single-shot calls —&#xa;orchestration power without&#xa;unbounded sub-loops" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="TOOLS">
