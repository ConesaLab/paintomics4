        <mxCell id="g1" value="the same Phase 6 net, unchanged:&#xa;verify_report_v2 (fuzzy quote match 0.75)&#xa;→ redact_unverified_v2 → renumber_citations&#xa;→ sort_references_section" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="GATE">
