        <mxCell id="e_submit_gate" value="checklist satisfied → submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.1;entryY=1;" edge="1" parent="1" source="ts" target="GATE">
