<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="How the analysis works">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1230" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="How the PaintOmics AI analysis is conducted" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="One round = 4 runs. 26 rounds so far, 57 runs kept. Everything below is in the repo: src/benchmarks/ai_arm_bench.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="A" value="A &#8212; INPUT: two jobs, built once, reused every round" style="swimlane;startSize=32;html=1;fillColor=#f8f9fb;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="84" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="STATegra multi-omics&#xa;examplefiles/datasets/08-stategra-multiomics&#xa;5 omic layers, 6 time points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="A">
          <mxGeometry x="24" y="46" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="ai_arm_bench jobs 2&#xa;POST /pa_step1 &#8594; /pa_step2&#xa;&#8594; 73I734364H, 1354co025T" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="A">
          <mxGeometry x="304" y="46" width="230" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ae1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;" edge="1" parent="A" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Why the same two jobs every round&lt;/b&gt;&#xa;The pathway data is then identical across rounds, so a&#xa;difference between arms is the arm and not the biology.&#xa;The interpretation record is overwritten each run, which&#xa;is why the metrics and the report are copied out." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="A">
          <mxGeometry x="24" y="128" width="510" height="82" as="geometry" />
        </mxCell>

        <mxCell id="B" value="B &#8212; THE ROUND: 4 runs, interleaved" style="swimlane;startSize=32;html=1;fillColor=#fffaf3;strokeColor=#d79b00;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="84" width="620" height="230" as="geometry" />
        </mxCell>
        <mxCell id="b0" value="gateway probe&#xa;refuses to start if the model service is down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="B">
          <mxGeometry x="24" y="44" width="200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="base-r1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="B">
          <mxGeometry x="252" y="44" width="82" height="34" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="agent-r1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="B">
          <mxGeometry x="348" y="44" width="82" height="34" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="base-r2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="B">
          <mxGeometry x="444" y="44" width="82" height="34" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="agent-r2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="B">
          <mxGeometry x="524" y="88" width="82" height="34" as="geometry" />
        </mxCell>
        <mxCell id="be0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;" edge="1" parent="B" source="b0" target="b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;" edge="1" parent="B" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;" edge="1" parent="B" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;" edge="1" parent="B" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="&lt;b&gt;Interleaved on purpose.&lt;/b&gt; Gateway throughput drifts over&#xa;tens of minutes. Running one arm's replicates back to back&#xa;lets that weather land entirely on one side and look like&#xa;a real effect.&#xa;&#xa;Each run is in-process, ceiling 600 s. AI_FULL_AGENT=1&#xa;selects the agent arm; everything else is identical." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="B">
          <mxGeometry x="24" y="132" width="572" height="80" as="geometry" />
        </mxCell>

        <mxCell id="C" value="C &#8212; WHAT ONE RUN LEAVES BEHIND" style="swimlane;startSize=32;html=1;fillColor=#f6fbf6;strokeColor=#82b366;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="336" width="1210" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;metrics JSON&lt;/b&gt;&#xa;wall_s, citations, redactions,&#xa;coverage, papers, chars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="C">
          <mxGeometry x="24" y="46" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;report .md&lt;/b&gt;&#xa;the prose itself &#8212; metrics&#xa;cannot say if it reads well" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="C">
          <mxGeometry x="274" y="46" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;trace JSONL&lt;/b&gt; (per run)&#xa;__config__ fingerprint &#183; every tool call&#xa;with args/result/ms &#183; __outcome__" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="C">
          <mxGeometry x="514" y="46" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;MongoDB record&lt;/b&gt;&#xa;report, papers, verification, stats&#xa;(one per JOB &#8212; overwritten each run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="C">
          <mxGeometry x="824" y="46" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="The trace is the only per-RUN record: Mongo keeps one interpretation per JOB, so with two jobs reused for 57 runs it can answer &quot;how did this job's last run go&quot; and nothing else." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="C">
          <mxGeometry x="24" y="126" width="1120" height="30" as="geometry" />
        </mxCell>

        <mxCell id="D" value="D &#8212; HOW EACH NUMBER IS DERIVED" style="swimlane;startSize=32;html=1;fillColor=#f8f9fb;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="538" width="700" height="330" as="geometry" />
        </mxCell>
        <mxCell id="d0" value="&lt;b&gt;prose&lt;/b&gt; = report up to the FIRST appended table&#xa;(&quot;## Enriched Pathway Summary&quot;, &quot;## Pathway Clusters&quot;, &quot;### References&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="D">
          <mxGeometry x="24" y="44" width="650" height="48" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;citations&lt;/b&gt; = distinct [N] in the body that resolve to a retrieved paper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="D">
          <mxGeometry x="24" y="102" width="650" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;redactions&lt;/b&gt; = verification.redacted_count &#8212; sentences+entries the gate removed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="D">
          <mxGeometry x="24" y="144" width="650" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;coverage&lt;/b&gt; = indexed pathway names that appear in the PROSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="D">
          <mxGeometry x="24" y="186" width="650" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;The trap this metric already fell into.&lt;/b&gt; The first version counted a pathway&#xa;as covered if its name appeared anywhere in the report. Both arms APPEND a&#xa;table of pathway names, so the agent arm scored 102/102 by printing a table it&#xa;had never analysed. The prose cut is now permanent and has its own tests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="D">
          <mxGeometry x="24" y="230" width="650" height="84" as="geometry" />
        </mxCell>

        <mxCell id="E" value="E &#8212; THE VERDICT: five rules, written before any arm ran" style="swimlane;startSize=32;html=1;fillColor=#fffaf3;strokeColor=#d79b00;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="538" width="480" height="330" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1  every replicate done, wall &#8804; 600 s&#xa;2  citations &#8805; base&#xa;3  redactions &#8804; base + 2&#xa;4  prose coverage &#8805; base&#xa;5  length within [0.6&#215;, 2.0&#215;] of base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="E">
          <mxGeometry x="24" y="46" width="430" height="112" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="ALL five must hold, or the incumbent stands." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#b85450;" vertex="1" parent="E">
          <mxGeometry x="24" y="164" width="430" height="22" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Runs are grouped by &lt;b&gt;code fingerprint&lt;/b&gt; &#8212; a hash of the&#xa;module source, the Lead prompt and every tool description.&#xa;Grouping changes the answer, so it is fixed in advance:&#xa;agent-v20 alone fails rule 3, pooled with v19 it passes.&#xa;&#xa;10 tests pin the rules and the prose cut, so they cannot&#xa;drift once the numbers exist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="E">
          <mxGeometry x="24" y="194" width="430" height="120" as="geometry" />
        </mxCell>

        <mxCell id="F" value="F &#8212; WHAT THE TRACES ARE FOR: diagnosis, not scoring" style="swimlane;startSize=32;html=1;fillColor=#f6fbf6;strokeColor=#82b366;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1210" height="200" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="ai_tool_usage&#xa;adoption, cost per call,&#xa;outcome per tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="F">
          <mxGeometry x="24" y="46" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="ai_citation_audit&#xa;integrity &#183; quotes &#183; pubmed&#xa;&#183; structure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="F">
          <mxGeometry x="244" y="46" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="per-event timeline&#xa;overlap, gaps, who waited&#xa;on whom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="F">
          <mxGeometry x="464" y="46" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&#8594;  a diagnosis  &#8594;  ONE change  &#8594;  new fingerprint  &#8594;  next round" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="F">
          <mxGeometry x="694" y="46" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="Example, round 25 &#8594; 26: the score said &quot;not better&quot;. The TRACE said why &#8212; r1 and r2 differed on one thing, whether the merged text's citations could be&#xa;grounded in the time left (r1: 11 citations / 0 redactions; r2: 0 / 44). Scores rank arms; traces explain them. Only the trace tells you what to change next." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="F">
          <mxGeometry x="24" y="118" width="1150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="G" value="G &#8212; GUARDS AGAINST FOOLING MYSELF" style="swimlane;startSize=32;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1280" y="84" width="510" height="1006" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;Pre-register the prediction AND the falsifier&lt;/b&gt;&#xa;Round 26 was written down before it ran: redactions&#xa;down, citations level or up &#8212; and &quot;citations falling&#xa;alongside redactions&quot; named in advance as the result&#xa;that would mean the diagnosis was wrong." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="G">
          <mxGeometry x="20" y="46" width="470" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;Never start against a broken instrument&lt;/b&gt;&#xa;Two replicates once burned ten minutes each against a&#xa;gateway returning 504 and produced two outage reports&#xa;dressed as results. The round now refuses to start, and&#xa;the probe names WHICH layer failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="G">
          <mxGeometry x="20" y="154" width="470" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;Split stored data by era before pooling&lt;/b&gt;&#xa;The database holds several code eras at once. Three&#xa;conclusions reversed when the same data was split by&#xa;date instead of pooled &#8212; a &quot;live&quot; redaction defect that&#xa;was March-only, missing telemetry that predated the&#xa;stat, and a retrieval fix that the pooled average&#xa;argued FOR and the split argued against." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="G">
          <mxGeometry x="20" y="262" width="470" height="124" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="&lt;b&gt;A ratio is not a measurement&lt;/b&gt;&#xa;47 s of verifier work inside a 55 s window looked like&#xa;0.9&#215; concurrency, and I drew it as a defect with a named&#xa;cause. Computing OVERLAP from the per-event intervals&#xa;showed two bursts of eleven. The span had contained&#xa;something else: a 48 s rewrite between rounds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="G">
          <mxGeometry x="20" y="398" width="470" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="&lt;b&gt;Keep the raw runs, not just the conclusions&lt;/b&gt;&#xa;57 per-run metric files live in the repo. The scorer&#xa;reproduces every verdict in the write-up, including the&#xa;ones that went against the arm I was building." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="G">
          <mxGeometry x="20" y="522" width="470" height="84" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="&lt;b&gt;One change per round&lt;/b&gt;&#xa;Nine changes accumulated during a gateway outage and&#xa;had to be measured as a bundle, which is why round 25&#xa;could rank the arm but not attribute the result. The&#xa;fingerprint at least says WHICH agent was measured." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="G">
          <mxGeometry x="20" y="618" width="470" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="&lt;b&gt;n=2 is a story, not a measurement&lt;/b&gt;&#xa;Two replicates of identical code once came out 47 094&#xa;and 10 043 characters of prose, and 5 vs 10 redactions.&#xa;A two-run mean is reported as a two-run mean; the&#xa;replicate spread is always shown beside it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="G">
          <mxGeometry x="20" y="726" width="470" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g8" value="&lt;b&gt;Verify the fix RAN before believing the result&lt;/b&gt;&#xa;Round 26's grounding step never executed: the guard&#xa;tested for [N] markers, but sub-agents emit (PMID: X)&#xa;until the merge converts them. The trace showed no&#xa;delegate_grounding event at all &#8212; which is how it was&#xa;caught, rather than being read as &quot;the fix did not help&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="G">
          <mxGeometry x="20" y="834" width="470" height="112" as="geometry" />
        </mxCell>

                <mxCell id="fe" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="F" target="C">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="20" y="880" /><mxPoint x="20" y="530" /></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
