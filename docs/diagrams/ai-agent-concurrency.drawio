            <Array as="points"><mxPoint x="575" y="140" /><mxPoint x="120" y="140" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tools" value="&lt;b&gt;10 tools, one per turn&lt;/b&gt;&#xa;get_experiment_overview &#183; get_pathway_details &#183; compare_gene_profiles  (0&#8211;20 ms, no LLM)&#xa;cluster_pathways (0.4 s, no LLM) &#183; search_literature (2 s) &#183; read_paper (2.5 s) &#183; notebook_write (free)&#xa;check_my_citations (1.3 s) &#183; delegate_interpretation (30 s) &#183; submit_report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="bandA">
          <mxGeometry x="700" y="48" width="410" height="140" as="geometry" />
        </mxCell>

        <mxCell id="bandB" value="2 &#8212; DELEGATION  &#183;  the only fan-out inside the loop" style="swimlane;startSize=34;html=1;fillColor=#fffaf3;strokeColor=#d79b00;fontStyle=1;fontSize=13;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="1140" height="270" as="geometry" />
        </mxCell>
        <mxCell id="delcall" value="delegate_interpretation&#xa;chunks of 5 pathways&#xa;asyncio.gather + Semaphore(4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="bandB">
          <mxGeometry x="30" y="80" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sub1" value="Cluster Interpreter #1&#xa;5 pathways, 10 papers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="bandB">
          <mxGeometry x="300" y="52" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="sub2" value="Cluster Interpreter #2&#xa;5 pathways, 10 papers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="bandB">
          <mxGeometry x="300" y="110" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="sub3" value="worker slot 3 &#8212; never used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#b3b3b3;fontColor=#8a8a8a;dashed=1;fontSize=11;" vertex="1" parent="bandB">
          <mxGeometry x="300" y="168" width="230" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sub4" value="worker slot 4 &#8212; never used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#b3b3b3;fontColor=#8a8a8a;dashed=1;fontSize=11;" vertex="1" parent="bandB">
          <mxGeometry x="300" y="208" width="230" height="34" as="geometry" />
        </mxCell>
        <mxCell id="eB1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="bandB" source="delcall" target="sub1">
          <mxGeometry relative="1" as="geometry" />
