          <mxGeometry x="30" y="55" width="180" height="58" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="Decide&#xa;&lt;b&gt;1 LLM call&lt;/b&gt; &#183; median 0.4&#8211;1.6 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="bandA">
          <mxGeometry x="250" y="55" width="200" height="58" as="geometry" />
        </mxCell>
        <mxCell id="act" value="Act&#xa;exactly ONE tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="bandA">
          <mxGeometry x="490" y="55" width="170" height="58" as="geometry" />
