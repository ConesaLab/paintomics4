        <mxCell id="eB2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;exitX=1;exitY=0.65;entryX=0;entryY=0.5;" edge="1" parent="bandB" source="delcall" target="sub2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="backto" value="text returned to the Lead&#xa;27 208 + 12 251 chars (r1)&#xa;21 756 + 30 606 chars (r2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="bandB">
          <mxGeometry x="590" y="72" width="220" height="66" as="geometry" />
        </mxCell>
        <mxCell id="eB3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="bandB" source="sub1" target="backto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eB4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="bandB" source="sub2" target="backto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="noteB" value="&lt;b&gt;Measured, both replicates:&lt;/b&gt;&#xa;2 delegate calls per run, 1&#8211;2 chunks each.&#xa;&#8594; at most &lt;b&gt;2&lt;/b&gt; sub-agents ever ran at once,&#xa;   out of 4 configured slots.&#xa;&#xa;The Lead waits for the whole gather before&#xa;its next turn, so the loop is idle for ~30 s&#xa;each time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="bandB">
          <mxGeometry x="850" y="52" width="260" height="190" as="geometry" />
        </mxCell>

        <mxCell id="bandC" value="3 &#8212; EXIT GATE  &#183;  outside the loop, after submit_report" style="swimlane;startSize=34;html=1;fillColor=#f6fbf6;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1140" height="330" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="merge / stitch&#xa;delegated text folded into the report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="bandC">
          <mxGeometry x="26" y="52" width="200" height="58" as="geometry" />
        </mxCell>
        <mxCell id="quotes" value="_collect_cited_quotes&#xa;find a verbatim sentence per citation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="bandC">
          <mxGeometry x="26" y="132" width="200" height="58" as="geometry" />
        </mxCell>
        <mxCell id="fan" value="per-citation verifiers &#8212; Semaphore(8), peak 11 observed" style="swimlane;startSize=26;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="bandC">
          <mxGeometry x="280" y="46" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="verify [1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="fan">
          <mxGeometry x="16" y="34" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="verify [2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="fan">
          <mxGeometry x="16" y="72" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="&#8230; 22 in a run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="fan">
          <mxGeometry x="16" y="110" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="block" value="&lt;b&gt;HEALTHY&lt;/b&gt;&#xa;2 bursts of &lt;b&gt;11 concurrent&lt;/b&gt;&#xa;verifiers, each burst done&#xa;in ~4 s (272.5 s and&#xa;324.1 s into the run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="fan">
          <mxGeometry x="172" y="34" width="146" height="106" as="geometry" />
        </mxCell>
        <mxCell id="chain" value="deterministic chain &#8212; no LLM&#xa;verify_report_v2 &#8594; redact_unverified_v2 &#8594;&#xa;renumber_citations &#8594; sort_references_section" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="bandC">
          <mxGeometry x="660" y="80" width="280" height="82" as="geometry" />
        </mxCell>
        <mxCell id="eC1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;" edge="1" parent="bandC" source="merge" target="quotes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eC2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="bandC" source="quotes" target="fan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eC3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="bandC" source="fan" target="chain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="noteC" value="&lt;b&gt;The serial cost is BETWEEN the bursts.&lt;/b&gt;&#xa;Verification runs twice. The 48 s gap between&#xa;round 1 (ends 276.6 s) and round 2 (starts&#xa;324.1 s) is ONE correction rewrite &#8212; a single&#xa;long-form model call that rewrites the report.&#xa;That, not the fan-out, is the gate&#8217;s serial cost." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="bandC">
          <mxGeometry x="280" y="216" width="330" height="96" as="geometry" />
        </mxCell>
        <mxCell id="noteC2" value="&lt;b&gt;The seam that sank r2&lt;/b&gt;&#xa;check_my_citations validates the &lt;i&gt;draft&lt;/i&gt;&#xa;(7 726 chars, 7 citations, all grounded).&#xa;The gate then merges 52 000 chars carrying&#xa;&lt;b&gt;44 citations the agent never checked&lt;/b&gt;,&#xa;cannot ground them in the time left, and&#xa;redacts every one &#8594; 0 citations shipped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="bandC">
          <mxGeometry x="660" y="186" width="450" height="126" as="geometry" />
        </mxCell>

        <mxCell id="side1" value="Where the 10 minutes goes" style="swimlane;startSize=30;html=1;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1220" y="90" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="s1a" value="Lead's own model turns&#xa;&lt;b&gt;50%&lt;/b&gt;  &#8212; one at a time, never overlapped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="side1">
          <mxGeometry x="20" y="42" width="380" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s1b" value="Tool execution&#xa;&lt;b&gt;32%&lt;/b&gt;  &#8212; delegation dominates it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="side1">
          <mxGeometry x="20" y="98" width="380" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s1c" value="Exit gate&#xa;&lt;b&gt;18%&lt;/b&gt;  &#8212; fan-out is fine; the rewrite is not" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="side1">
          <mxGeometry x="20" y="154" width="380" height="46" as="geometry" />
        </mxCell>

        <mxCell id="side2" value="Concurrency, configured vs measured" style="swimlane;startSize=30;html=1;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1220" y="350" width="420" height="270" as="geometry" />
        </mxCell>
        <mxCell id="s2a" value="Lead loop&#xa;configured: 1  &#183;  measured: &lt;b&gt;1&lt;/b&gt;  (by design)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="side2">
          <mxGeometry x="20" y="42" width="380" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s2b" value="Sub-agents (DELEGATE_WORKERS)&#xa;configured: 4  &#183;  measured: &lt;b&gt;2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="side2">
          <mxGeometry x="20" y="96" width="380" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s2c" value="Citation verifiers (SDK_VERIFY_CONCURRENCY)&#xa;configured: 8  &#183;  measured: &lt;b&gt;11 at once&lt;/b&gt;, 2 bursts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="side2">
          <mxGeometry x="20" y="150" width="380" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s2d" value="Literature search&#xa;configured: none  &#183;  measured: &lt;b&gt;1&lt;/b&gt;, 22&#8211;25 per run, serial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="side2">
          <mxGeometry x="20" y="204" width="380" height="46" as="geometry" />
        </mxCell>

        <mxCell id="side3" value="Peak: 11 in the gate, 2 in the loop" style="swimlane;startSize=30;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1220" y="650" width="420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="s3a" value="Across a 330 s run the system has more than one&#xa;model call in flight for roughly &lt;b&gt;70 s&lt;/b&gt; &#8212; two&#xa;delegation waves plus two verifier bursts.&#xa;Everything else is one call at a time.&#xa;&#xa;&lt;b&gt;Three ways to widen it&lt;/b&gt;&#xa;1.  Delegate in one wave of 4&#8211;6 chunks instead of&#xa;    two waves of 1&#8211;2: breadth costs 30 s, not 60 s.&#xa;2.  Let each sub-agent ground its own citations&#xa;    while it still holds its papers &#8212; parallel work&#xa;    that also closes the seam below.&#xa;3.  The gate&#8217;s 48 s correction rewrite is one&#xa;    serial call. Rewriting only the failed&#xa;    sections would cut most of it.&#xa;&#xa;&lt;i&gt;Not a lever: the verifier fan-out. It already&#xa;runs 11 wide and finishes a burst in 4 s.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;" vertex="1" parent="side3">
          <mxGeometry x="16" y="40" width="392" height="280" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend">
          <mxGeometry x="14" y="30" width="26" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg1t" value="LLM call" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="46" y="28" width="90" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="legend">
          <mxGeometry x="150" y="30" width="26" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg2t" value="parallel region" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="182" y="28" width="110" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend">
          <mxGeometry x="300" y="30" width="26" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg3t" value="deterministic, no LLM" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="332" y="28" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="legend">
          <mxGeometry x="490" y="30" width="26" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg4t" value="measured defect" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="522" y="28" width="130" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="" style="rounded=0;html=1;fillColor=#f0f0f0;strokeColor=#b3b3b3;dashed=1;" vertex="1" parent="legend">
          <mxGeometry x="660" y="30" width="26" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg5t" value="configured capacity never used" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="692" y="28" width="220" height="20" as="geometry" />
        </mxCell>
      </root>
