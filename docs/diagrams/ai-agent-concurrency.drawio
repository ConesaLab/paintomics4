        <mxCell id="title" value="PaintOmics AI &#8212; agent arm: what actually runs at once" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Measured on round 25 (2026-08-18, fingerprint e92a9a5737, jobs 73I734364H + 1354co025T)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="bandA" value="1 &#8212; THE LOOP  &#183;  strictly sequential  &#183;  one model call in flight, ever" style="swimlane;startSize=34;html=1;fillColor=#f8f9fb;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
