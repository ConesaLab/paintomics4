          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eA3" value="repeat &#8212; 46 turns measured (cap 40)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.5;entryY=1;fontSize=11;labelBackgroundColor=#f8f9fb;" edge="1" parent="bandA" source="act" target="obs">
