# Set default behavior to automatically normalize line endings.
* text=auto

# Force LF for all text files (overrides core.autocrlf)
* text eol=lf

# Denote all files that are truly binary and should not be modified.
# Compressed archives MUST be listed here: with `* text eol=lf` above, git
# rewrites CRLF byte pairs inside the compressed stream, which silently
# truncates the payload rather than failing -- a gzipped mapping file came
# back 15,834 of its 25,466 lines and still looked like a valid commit.
*.gz binary
*.gzip binary
*.tgz binary
*.bz2 binary
*.xz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
# The conversion sandbox's WebAssembly runtime and its Python wheels. A wheel
# is a zip and the wasm is a binary module; under `* text eol=lf` above git
# rewrites CRLF byte pairs inside both and truncates them without failing --
# the same way a gzipped mapping file came back at 62% and still looked like a
# valid commit. Pyodide would then fail to instantiate with no clue why.
*.wasm binary
*.whl binary
*.data binary
*.pdf binary
*.ttf binary
*.otf binary
*.eot binary
*.woff binary
*.woff2 binary
