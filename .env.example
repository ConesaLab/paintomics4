# Example environment configuration for Paintomics 4
# Copy to a secure location (not committed) and set values there.

# Email: SMTP configuration
# Gmail is recommended for reliable delivery with app passwords
# Generate app password at: https://myaccount.google.com/apppasswords

# Gmail SMTP (recommended - reliable and easy setup)
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_FROM_DISPLAY=PaintOmics
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_USE_TLS=True

# Alternative: SendGrid (if you prefer)
# Obtain API key from SendGrid dashboard
SENDGRID_API_KEY=

# Web-facing configuration (optional overrides)
PAINTOMICS_BASE_URL=https://paintomics.uv.es
PAINTOMICS_LOGO_PATH=/resources/images/paintomics_white_300x66
PAINTOMICS_LOGIN_URL=
PAINTOMICS_DOCS_URL=https://paintomics.readthedocs.io/en/latest/
PAINTOMICS_EMAIL_DOMAIN=

# Recipient list for email reports (comma-separated)
EMAIL_REPORT_RECIPIENTS=admin@example.com

# Never commit a real .env file. Use this as documentation only.
