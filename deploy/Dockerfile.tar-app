# Alternative application-layer packaging.
#
# Use this in place of the directory COPY steps in deploy/Dockerfile when
# `COPY PaintomicsServer /app/...` corrupts the image rootfs -- a failure that
# shows up as every subsequent RUN dying with
#
#   runc run failed: unable to start container process:
#   error during container init: exec: "/bin/sh": stat /bin/sh: no such file
#
# even though /bin/sh was present in the preceding layer, and which reproduces
# with --no-cache and a pruned builder cache.
#
# Copying a single tar archive and unpacking it in a RUN sidesteps large
# multi-file directory COPY entirely. It also handles the repository's symlinks
# natively -- tar stores them as symlinks, including the cyclic
# src/src -> ../src -- so the .dockerignore exclusions and the explicit `ln -s`
# recreation are unnecessary with this approach.
#
# Build the archive first (deploy/build-image.sh does this):
#
#   tar -cf deploy/app.tar \
#       --exclude='__pycache__' --exclude='*.pyc' \
#       --exclude='PaintomicsServer/src/conf/serverconf.py' \
#       PaintomicsServer PaintomicsClient
#
# Replace these lines in deploy/Dockerfile:
#
#   COPY --chown=paintomics:paintomics PaintomicsServer /app/PaintomicsServer
#   COPY --chown=paintomics:paintomics PaintomicsClient /app/PaintomicsClient
#   ... plus the `RUN set -eux; ln -sfn ...` block
#
# with:

COPY deploy/app.tar /tmp/app.tar
RUN set -eux; \
    mkdir -p /app; \
    tar -xf /tmp/app.tar -C /app; \
    rm -f /tmp/app.tar; \
    mkdir -p /app/PaintomicsServer/src/log; \
    chown -R paintomics:paintomics /app; \
    test -L /app/PaintomicsServer/src/src; \
    test -L /app/PaintomicsServer/src/AdminTools/src; \
    test -e /app/PaintomicsServer/src/public_html
