# Byte-compiled / optimized / DLL files
**/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
junit.xml

# Translations
*.mo
*.pot

# Django stuff:
*.log
**/local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# Environment variables
.env
.env.local
.env.*.local
!.env.example
/.venv
/.venv/**

# Deployment secrets: TLS private keys and the environment file. The .env
# pattern below already covers deploy/.env; certs need their own rule.
deploy/nginx/certs/
*.key
*.pem

# Configuration files
# The real server config holds credentials and must never be tracked. The
# leading-slash patterns below only ever matched the repo root, so the actual
# config at PaintomicsServer/src/conf/serverconf.py was committed for years
# with a live API key in it. Match it wherever it lives.
**/conf/serverconf.py
**/conf/local_serverconf.py
/serverconf.py
/local_serverconf.py
paintomics4.ini
**/config.ini

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.iml

# JavaScript/Node
node_modules/
**/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs
*.log
*.log.*

# R history files
.Rhistory

# Others
*.swp
*.swo
*.tmp



# Large genome / sequence data files (should not be committed)
# Common FASTA/GTF/GFF patterns and compressed variants
*.fa
*.fasta
*.fa.gz
*.fasta.gz
*.gtf
*.gff

# Example data directories that may contain large files
PaintomicsServer/src/examplefiles/
PaintomicsServer/src/examplefiles/GTF/

# MkDocs generated site
site/

# Debug/generated output files
git_diff_output.txt
recent_files_output.txt
pvalue_fix.md

# AI assistant files
CLAUDE.md

# Temp/test directories
PaintomicsServer/tmp/
PaintomicsServer/tmpperf_user/
PaintomicsServer/tmptest_user/

# Accidental nested directory
PaintomicsClient/public_html/public_html

# Autoresearch loop tracking (ephemeral, not part of code review)
.autoresearch/

# Generated by deploy/build-image.sh
deploy/app.tar
